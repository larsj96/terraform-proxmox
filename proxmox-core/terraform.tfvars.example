proxmox_endpoint         = "https://10.0.0.162:8006/"
proxmox_insecure         = true
proxmox_ssh_node_address = "10.0.0.162"
target_node_name         = "hp1"
vm_placement_mode        = "explicit"
placement_nodes          = ["hp1", "hp2", "hp3"]
vm_node_placement = {
  # Keep all on hp1 by default. Override only after migrations are planned.
  # mkdocs      = "hp2"
  # docker1     = "hp3"
  # auth1       = "hp2"
}
target_storage           = "nvme-local"
image_storage            = "local"
snippets_storage         = "snippetsogISO"
pool_name                = "homelab"
vm_id                    = 9001
vm_name                  = "ubuntu-noble-test-01"
vm_description           = "Managed by Terraform"
vm_tags                  = ["terraform", "ubuntu", "test"]
vm_cpu_cores             = 2
vm_memory_mb             = 4096
vm_disk_size_gb          = 60
vm_bridge                = "vmbr0"
vm_vlan_id               = 110
vm_ipv4_address          = "dhcp"
vm_ipv4_gateway          = "10.0.0.161"
vm_dns_servers           = ["1.1.1.1", "8.8.8.8"]
vm_username              = "ubuntu"
vm_ssh_public_keys = []
workstation_ssh_public_key = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIL6rilckgv40NViw/SrFwiGMbWeaxc/pT6yE8GGoOcKS ljn@WORKSTATION"
bastion_ssh_public_key     = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIDA6/AtLMyDq7wIPTD8vh0Rf5KBWd0pk22CK8Zn6vWlO ubuntu@bastion01"
ubuntu_cloud_image_url     = "https://cloud-images.ubuntu.com/releases/noble/release-20260518/ubuntu-24.04-server-cloudimg-amd64.img"

# Optional native Proxmox datacenter metrics push to InfluxDB.
# Telegraf already scrapes Proxmox through the API; enable this only when you
# want Proxmox itself to push its native metric stream into the same bucket.
enable_proxmox_native_metrics       = false
proxmox_metrics_influx_server       = "10.0.0.38"
proxmox_metrics_influx_port         = 8086
proxmox_metrics_influx_protocol     = "http"
proxmox_metrics_influx_organization = "lanilsen"
proxmox_metrics_influx_bucket       = "homelab"
